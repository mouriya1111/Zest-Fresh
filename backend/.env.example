NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/zest-fresh
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8081

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FCM_SERVER_KEY=

# OTP delivery
# Leave empty only for local development. Production requires fast2sms or twilio.
OTP_SMS_PROVIDER=
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_COUNTRY_CODE=+91

REGISTRATION_MODE=otp
PAYMENT_GATEWAY=razorpay
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
